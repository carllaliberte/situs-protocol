{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carllaliberte/situs-protocol/schema/quittance.v0.json",
  "title": "Quittance SITUS v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "empreinte", "usage", "lab", "decision", "emise_at", "cle_publique", "signature"],
  "properties": {
    "format": { "const": "situs-quittance.v0" },
    "id": { "type": "string" },
    "empreinte": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "usage": { "enum": ["capture", "train", "sim", "deploy"] },
    "lab": { "type": "string" },
    "decision": { "enum": ["allow", "urgent"] },
    "emise_at": { "type": "string" },
    "revoque_at": { "type": ["string", "null"] },
    "cle_publique": { "type": "string" },
    "cle_publique_ml": { "type": ["string", "null"] },
    "schema_sig": { "enum": ["ed25519", "UFHY1"] },
    "signature": { "type": "string" }
  }
}
